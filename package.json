{
  "name": "toolshop-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "E2E test automation for practicesoftwaretesting.com (Toolshop) — Playwright + TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "cases:lint": "node scripts/validate-cases.js",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "otplib": "^12.0.1",
    "typescript": "^7.0.2"
  }
}
